{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug icosudoku",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/icosudoku/bin/Debug/netcoreapp3.1/icosudoku_gui.dll",
      "cwd": "${workspaceFolder}/icosudoku",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "windows": {
        "program": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
        "args": [
          "${workspaceFolder}/icosudoku/bin/Debug/netcoreapp3.1/icosudoku_gui.dll"
        ],
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5000",
          "DOTNET_ROOT": "${env:USERPROFILE}\\.dotnet",
          "PATH": "${env:USERPROFILE}\\.dotnet;${env:PATH}"
        }
      }
    },
    {
